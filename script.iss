[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{B37B868D-2194-4EA3-BBAB-6E9BC74022E2}
AppName=WAIGE Translate
AppVersion=1.0
;AppVerName=WAIGE Translate 1.0
AppPublisher=Natnael Tibebu
DefaultDirName={autopf}\WAIGE Translate
UninstallDisplayIcon={app}\WAIGE-x86.exe
DisableProgramGroupPage=yes
; Uncomment the following line to run in non administrative install mode (install for current user only).
;PrivilegesRequired=lowest
OutputDir=C:\Users\acera\OneDrive\Desktop\WAIGE
OutputBaseFilename=WaigeSetup
SolidCompression=yes
WizardStyle=modern dynamic

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "C:\Users\acera\OneDrive\Desktop\WAIGE\dist\WAIGE-x86.exe"; DestDir: "{app}"; Flags: ignoreversion
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Icons]
Name: "{autoprograms}\WAIGE Translate"; Filename: "{app}\WAIGE-x86.exe"
Name: "{autodesktop}\WAIGE Translate"; Filename: "{app}\WAIGE-x86.exe"; Tasks: desktopicon

[Run]
Filename: "{app}\WAIGE-x86.exe"; Description: "{cm:LaunchProgram,WAIGE Translate}"; Flags: nowait postinstall skipifsilent

